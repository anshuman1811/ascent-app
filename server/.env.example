# Anthropic API key — powers the "AI Parse Food" natural-language food logging
# feature (POST /api/ai/parse-food). Optional: without it, that one endpoint
# returns a 503 and everything else in the app works normally.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Where the SQLite database file lives. Optional — defaults to ../data/fitness.db
# (relative to server/db/), created automatically on first run.
# DB_PATH=../data/fitness.db
